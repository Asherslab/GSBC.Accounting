@page "/drafts"
@using GSBC.Accounting.Shared.Contracts.Entities.Features.Expenses
@using GSBC.Accounting.Shared.Contracts.Messages.Requests.Features.Expenses
@using GSBC.Accounting.Shared.Contracts.Messages.Responses.Base
@using GSBC.Accounting.Shared.Contracts.Messages.Responses.Features.Expenses
@using GSBC.Accounting.Shared.Contracts.Services.Features.Expenses
@using GSBC.Accounting.WASM.Features.Expenses
@inject IExpenseSubmissionService Submissions
@inject DraftSession Session

<PageTitle>Your saved drafts</PageTitle>

@*
    The list of unsubmitted forms belonging to this browser.

    WHOSE DRAFTS THESE ARE IS DECIDED ENTIRELY BY THE COOKIE. This page sends no identifier of any kind
    - there is nothing here to tamper with, which is the point. A browser with no session gets an empty
    list rather than an error, because "you have no drafts" is both true and the only useful thing to
    say to somebody who has not started one.

    Submitted claims are deliberately absent. They are evidence, they cannot be edited, and the only
    thing this page could offer for one is a link to a PDF - which is a different screen for a different
    reader, and not one this scope builds.
*@

<div class="layout norail">
    <main>
        <p class="lede">
            Forms started in this browser and not yet submitted.
        </p>

        @if (_error is not null)
        {
            <div class="banner" role="alert">
                <h4>Your drafts could not be loaded</h4>
                <p>@_error</p>
            </div>
        }

        @if (_loading)
        {
            <p class="help">Loading…</p>
        }
        else if (_drafts.Count == 0)
        {
            <section class="card">
                <header>
                    <span class="num">&mdash;</span>
                    <h3>No saved drafts</h3>
                </header>
                <div class="body">
                    <p class="help">
                        Nothing has been started in this browser yet. The form is saved
                        automatically, so one will appear here as soon as you begin.
                    </p>
                    <p><a class="cardlink" href="/">Back to the forms</a></p>
                </div>
            </section>
        }
        else
        {
            @foreach (DraftSummary draft in _drafts)
            {
                @*
                    Named by what is on it, not numbered. The header used to carry a sequence number -
                    01, 02 - which is internal and means nothing to a claimant, over the heading
                    "Expense Reimbursement", which every draft in the list may well share. With three
                    in flight there was no way to tell them apart except by the amount.
                *@
                <section class="card" @key="draft.Id">
                    <header>
                        <h3>@Label(draft)</h3>
                        <span class="hint">@KindLabel(draft.Kind) &middot; last edited @Ago(draft.UpdatedAt)</span>
                    </header>
                    <div class="body">
                        @if (!string.IsNullOrWhiteSpace(draft.PurposeActivity))
                        {
                            <p>@draft.PurposeActivity</p>
                        }

                        <p class="help">
                            @draft.GrossTotal.ToString("C2")
                            &middot; @draft.DetailCount purchase@(draft.DetailCount == 1 ? "" : "s")
                            &middot; @draft.AttachmentCount file@(draft.AttachmentCount == 1 ? "" : "s")
                        </p>

                        @if (draft.AttachmentCount == 0)
                        {
                            @* The one thing that will stop this being submittable, said before they
                               open it rather than after they have filled the rest in again. *@
                            <div class="notice bad">
                                <span class="ico">!</span>
                                <div>
                                    No receipt attached. At least one receipt is required before this
                                    form can be submitted.
                                </div>
                            </div>
                        }

                        <p class="help">
                            Expires @draft.ExpiresAt.ToLocalTime().ToString("d MMMM yyyy") unless
                            edited.
                        </p>

                        <p>
                            <a class="cardlink" href="@ResumeUrl(draft)">Continue this form</a>
                        </p>

                        @if (_confirming == draft.Id)
                        {
                            @* A second press rather than a JS confirm(). A browser dialog blocks the
                               whole page, and the mockup's language is the app's own - "discard" is a
                               word this form gets to define. *@
                            <div class="notice bad" role="alert">
                                <span class="ico">!</span>
                                <div>
                                    <b>Discard this draft?</b> It will be removed and cannot be
                                    recovered, along with everything entered into it.
                                    <p>
                                        <button class="b" type="button" disabled="@_busy"
                                                @onclick="() => Discard(draft)">
                                            @(_busy ? "Discarding…" : "Discard draft")
                                        </button>
                                        <button class="b" type="button" disabled="@_busy"
                                                @onclick="() => _confirming = null">
                                            Keep it
                                        </button>
                                    </p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p>
                                <button class="b" type="button" @onclick="() => _confirming = draft.Id">
                                    Discard
                                </button>
                            </p>
                        }
                    </div>
                </section>
            }

            <p class="footnote">
                Drafts are stored in this browser and are not shared between devices. Clearing
                browsing data removes them, and so does opening the form in a private window. Nobody
                else can see a draft &mdash; not an approver, and not Finance &mdash; until you submit
                it.
            </p>
        }

        @*
            CLAIMS THIS BROWSER HAS ALREADY FILED, and the answer to a question the app previously had
            none for. Once a claim was submitted the claimant's only record was the tab they were
            looking at: close it, and they had a reference they had not written down and a drafts list
            that no longer contained the claim.

            Not a second drafts list. Nothing here opens a form - a submitted claim is evidence, and
            the only things offered for it are its reference and its PDF, which is what a submitted
            claim is read as. That is also why it sits below the drafts rather than above them: the
            reason somebody comes to this page is nearly always to carry on with something.
        *@
        @if (_submitted.Count > 0)
        {
            <h2 class="listhead">Submitted claims</h2>

            @foreach (DraftSummary claim in _submitted)
            {
                <section class="card" @key="claim.Id">
                    <header>
                        <h3>@Label(claim)</h3>
                        <span class="hint">
                            @KindLabel(claim.Kind)
                            @if (claim.SubmittedAt is { } when)
                            {
                                <text> &middot; submitted @when.ToLocalTime().ToString("d MMMM yyyy")</text>
                            }
                        </span>
                    </header>
                    <div class="body">
                        <p>
                            Reference <span class="refcode">@claim.Reference</span>
                        </p>
                        <p class="help">
                            @claim.GrossTotal.ToString("C2")
                            &middot; @claim.DetailCount purchase@(claim.DetailCount == 1 ? "" : "s")
                            &middot; @claim.AttachmentCount file@(claim.AttachmentCount == 1 ? "" : "s")
                        </p>
                        <p>
                            <a class="cardlink" href="@PdfUrl(claim)" target="_blank" rel="noopener">
                                Open the printable form (PDF)
                            </a>
                        </p>
                        <p class="help">
                            This claim cannot be edited. To correct anything on it, contact Finance and
                            quote the reference.
                        </p>
                    </div>
                </section>
            }
        }
    </main>
</div>

@code
{
    [CascadingParameter] private MainLayout Layout { get; set; } = default!;

    private readonly List<DraftSummary> _drafts = [];

    /// <summary>Claims this browser has already filed. Read-only; nothing here reopens one.</summary>
    private readonly List<DraftSummary> _submitted = [];

    private bool _loading = true;
    private bool _busy;
    private string? _error;

    /// <summary>Which draft is showing its confirm step. At most one at a time.</summary>
    private Guid? _confirming;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("Your saved drafts");

        await Load();
    }

    /// <param name="force">
    /// Re-ask the server rather than reuse the answer the landing page already got. False on first
    /// paint - arriving here from the home page should not cost a second round trip - and true after a
    /// discard, when the cached list is known stale.
    /// </param>
    private async Task Load(bool force = false)
    {
        _loading = true;
        _error = null;

        try
        {
            // NO SESSION IS AN EMPTY LIST, NOT AN ERROR. ListDrafts is behind the AnonymousSession
            // policy, so a browser that has never saved a draft is refused before the method runs -
            // correct on the server, and useless to show somebody. DraftSession swallows exactly that
            // refusal (in every shape it arrives in) and answers null, which is why this page no longer
            // greets a first-time visitor with "Could not reach the server".
            ListDraftsResponse? response = await Session.DraftsAsync(force);

            _drafts.Clear();
            _submitted.Clear();

            if (response is null)
            {
                // No session. Falls through to the "No saved drafts" card, which is both true and the
                // only useful thing to say to somebody who has not started one.
            }
            else if (response.Success)
            {
                _drafts.AddRange(response.Drafts);
                _submitted.AddRange(response.Submitted);
            }
            else
            {
                _error = response.Error ?? "The list could not be loaded.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the server: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Discard(DraftSummary draft)
    {
        _busy = true;

        try
        {
            BasicResponse response =
                await Submissions.DiscardDraft(new DiscardDraftRequest { SubmissionId = draft.Id });

            if (response.Success)
            {
                _confirming = null;

                // Reloaded rather than removed from the list in place. The server is the only thing
                // that knows what this session owns, and a list that quietly diverges from it is how a
                // discarded draft comes back on the next visit and looks like the button did nothing.
                await Load(force: true);
            }
            else
            {
                _error = response.Error ?? "That draft could not be discarded.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the server: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// One route for both kinds. The form reads the kind off the stored draft rather than off the URL,
    /// so a resumed draft comes back with question zero already answered - and answered by the row that
    /// was validated, not by the link that was clicked.
    /// </summary>
    private static string ResumeUrl(DraftSummary draft) => $"/forms/expense/{draft.Id}";

    /// <summary>
    /// The printable form for a submitted claim. Addressed by the submission id, not by the reference:
    /// the GUID is what every URL in this app uses, and it is unguessable where the reference is not.
    /// </summary>
    private static string PdfUrl(DraftSummary claim) => $"/api/submissions/{claim.Id}/pdf";

    /// <summary>
    /// What to call one draft in a list of them.
    /// </summary>
    /// <remarks>
    /// The supplier and the amount first, because on a receipt-first form the shop is the first thing
    /// the claimant typed and the thing they were standing in - "Woolworths Glenroy · $42.10" is the
    /// answer to "which one was this?" that they actually hold.
    /// <para>
    /// The claimant's own name is the FALLBACK and not the label, which is the opposite of what this
    /// page did. Every draft in this list belongs to the same browser, so on a list of three it is the
    /// same word three times - it only distinguishes anything when somebody has filled in section 1 and
    /// not yet attached a receipt, which is the one case it is used for.
    /// </para>
    /// <para>
    /// The date started is the last resort, and it is never "Unnamed draft". A row with no label reads
    /// as a broken list; a row that says when it was begun is at least true of that draft alone.
    /// </para>
    /// </remarks>
    private static string Label(DraftSummary draft)
    {
        if (!string.IsNullOrWhiteSpace(draft.FirstSupplier))
        {
            return draft.GrossTotal > 0m
                ? $"{draft.FirstSupplier} · {draft.GrossTotal:C2}"
                : draft.FirstSupplier;
        }

        if (!string.IsNullOrWhiteSpace(draft.SubmitterName))
            return draft.SubmitterName;

        return $"Started {draft.CreatedAt.ToLocalTime():d MMMM}";
    }

    /// <summary>
    /// Still per kind, and still shown - in the hint now rather than as the heading. A saved draft
    /// <i>is</i> one of the two forms by the time it is on this list, and somebody scanning three of
    /// them needs to see which is which; what it cannot be is the thing that tells them apart, because
    /// it is usually the same on all three.
    /// </summary>
    private static string KindLabel(SubmissionKind kind) =>
        kind == SubmissionKind.DebitCardPurchase
            ? "Church Debit Card Purchase"
            : "Expense Reimbursement";

    /// <summary>
    /// A rough age rather than a timestamp. "Yesterday" is what somebody looking for the form they
    /// were filling in actually wants; the exact minute is noise on a list of three items.
    /// </summary>
    private static string Ago(DateTime utc)
    {
        TimeSpan since = DateTime.UtcNow - utc;

        return since switch
        {
            { TotalMinutes: < 2 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)since.TotalMinutes} minutes ago",
            { TotalHours: < 2 } => "an hour ago",
            { TotalHours: < 24 } => $"{(int)since.TotalHours} hours ago",
            { TotalDays: < 2 } => "yesterday",
            { TotalDays: < 30 } => $"{(int)since.TotalDays} days ago",
            _ => utc.ToLocalTime().ToString("d MMMM yyyy")
        };
    }
}
