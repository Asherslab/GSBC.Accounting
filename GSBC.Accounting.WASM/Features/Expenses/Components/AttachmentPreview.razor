@using GSBC.Accounting.Shared.Contracts.Entities.Features.Expenses
@using GSBC.Accounting.WASM.Features.Expenses

@*
    Looking at one receipt without leaving the form.

    This exists because expense details are per-receipt now. Somebody who has photographed four dockets
    on their phone gets four files called IMG_4471.jpeg through IMG_4474.jpeg, and is then asked which
    supplier, which date and what was on each - a question the filename cannot answer. Before this, the
    only way to check was to download the file, which on a phone means leaving the form.

    IMAGES AND PDFs RENDER; EVERYTHING ELSE GETS A LINK.

    A PDF is the common case for a receipt, and it used to be the one this modal could not show. The
    server now serves one inline to the OWNER of the submission - see AttachmentEndpoints'
    OwnerPreviewableInline for why that reader and no other - and this component is only ever mounted on
    the claimant's own draft, so the owner is who is looking. It goes in an <object> rather than an
    <img>, which cannot render a PDF, and rather than an <iframe>, which Safari will not.

    HEIC still gets the link: no browser renders it, so an inline frame would buy a blank panel.
*@

@if (File is not null)
{
    @* The backdrop closes it, and it is a plain button rather than a div with an onclick so that it is
       reachable by keyboard and announced as a control. It sits BEHIND the panel in the z-order. *@
    <div class="preview">
        <button type="button" class="preview-scrim" aria-label="Close the preview" @onclick="Close"></button>

        @* Wide when there is something to actually look at, and the old narrow panel for the fallback,
           which is one sentence and two buttons and would look abandoned in a full-screen dialog. *@
        <div class="preview-panel @(Renderable || RenderablePdf ? "wide" : "")"
             role="dialog" aria-modal="true" aria-label="@($"Preview of {File.FileName}")">
            <header>
                <div class="meta">
                    <span class="name">@File.FileName</span>
                    <span class="sz">@Format(File.ContentType) &middot; @Size(File.ByteSize)</span>
                </div>
                <button type="button" class="rowbtn" aria-label="Close the preview" @onclick="Close">&times;</button>
            </header>

            <div class="preview-body">
                @if (Renderable)
                {
                    @*
                        Same-origin, so the draft session cookie goes with the request and a private
                        draft's receipt stays private. No JS interop and no blob URL: the browser fetches
                        it the way it fetches any image.

                        Wrapped in a button because an A4 tax invoice fitted to a 390px screen is not
                        readable, and the only way through used to be "Open the file", which leaves the
                        form on a phone. Tap once for the picture at its own size and scroll it inside
                        the panel; tap again to fit. A button rather than a click handler on the image
                        so the same thing is reachable from a keyboard and announced as a control.
                    *@
                    <button type="button" class="preview-zoom @(_zoomed ? "zoomed" : "")"
                            aria-pressed="@_zoomed"
                            title="@(_zoomed ? "Fit the receipt to the screen" : "Show the receipt at full size")"
                            @onclick="() => _zoomed = !_zoomed">
                        <img src="@AttachmentClient.PreviewUrl(File.SubmissionId, File.Id)" alt="@File.FileName"/>
                    </button>
                }
                else if (RenderablePdf)
                {
                    @*
                        <object>, NOT <iframe>, and Safari is the whole reason. WebKit renders a PDF in
                        an iframe as a grey panel - it paints the first frame and then gives up, with
                        nothing in the console once the sandbox stopped complaining. The same URL opened
                        as a top-level document renders there perfectly, which is what narrowed it to
                        the framing rather than the response. Chrome is happy either way.

                        No zoom button around it: the browser's own PDF viewer brings its own zoom, page
                        controls and scrolling, and wrapping it in ours would fight it.

                        The content between the tags is what a browser that cannot render the type shows
                        instead - so the next browser to refuse gets a sentence and a way out rather
                        than the grey rectangle this replaced.
                    *@
                    <object data="@AttachmentClient.PreviewUrl(File.SubmissionId, File.Id)"
                            type="application/pdf"
                            title="@($"Preview of {File.FileName}")">
                        <p class="help">
                            This PDF cannot be shown here. Open it to check which receipt it is.
                        </p>
                    </object>
                }
                else
                {
                    <p class="help">
                        This kind of file cannot be shown here &mdash; photographs and PDFs can. Open
                        it to check which receipt it is.
                    </p>
                }
            </div>

            <footer>
                @* target=_blank rather than a download attribute: the response already carries
                   Content-Disposition, so the browser saves it either way, and _blank keeps the
                   half-filled form in the tab behind it. *@
                <a class="b" href="@AttachmentClient.DownloadUrl(File.SubmissionId, File.Id)"
                   target="_blank" rel="noopener">Open the file</a>
                <button type="button" class="b" @onclick="Close">Close</button>
            </footer>
        </div>
    </div>
}

@code
{
    /// <summary>The file being looked at, or null when the modal is closed.</summary>
    [Parameter] public ExpenseAttachment? File { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Matches the server's inline allowlist. Duplicated deliberately - the server is the authority and
    /// refuses the rest, but a browser that only discovers this after requesting the file shows a broken
    /// image icon where a sentence explaining the situation belongs.
    /// </summary>
    private bool Renderable => File?.ContentType is "image/jpeg" or "image/png" or "image/webp";

    /// <summary>
    /// A PDF, which renders in an <c>&lt;object&gt;</c> rather than an <c>&lt;img&gt;</c>.
    /// </summary>
    /// <remarks>
    /// Separate from <see cref="Renderable"/> rather than folded into it because the two are rendered by
    /// different elements, and because the server's rule for this one is narrower: it serves a PDF
    /// inline only to the owner of the submission. This component is mounted on the claimant's own
    /// draft, so that holds wherever it is used today - and if it is ever reused on a submitted claim
    /// somebody else is reading, this is the line that has to be revisited.
    /// </remarks>
    private bool RenderablePdf => File?.ContentType is "application/pdf";

    /// <summary>
    /// Whether the picture is at its own size rather than fitted to the panel. Reset when the modal is
    /// closed, so opening the next receipt starts fitted - a second receipt that opened already zoomed
    /// into its top-left corner reads as the preview being broken.
    /// </summary>
    private bool _zoomed;

    private Task Close()
    {
        _zoomed = false;

        return OnClose.InvokeAsync();
    }

    private static string Format(string contentType) => contentType switch
    {
        "application/pdf" => "PDF",
        "image/jpeg" => "JPEG photo",
        "image/png" => "PNG image",
        "image/heic" or "image/heif" => "HEIC photo",
        "image/webp" => "WebP image",
        _ => contentType
    };

    private static string Size(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / (1024.0 * 1024.0):0.#} MB";
}
