@using GSBC.Accounting.Shared.Contracts.Entities.Features.Expenses
@using GSBC.Accounting.WASM.Features.Expenses

@*
    Section 3, for both forms. Columns 4 to 7 are identical on the two documents; columns 1 to 3 differ,
    and column 1 differs in TYPE - text on the debit card form, a date on the reimbursement form - which
    is why this renders one or the other rather than relabelling one input.
*@

<div class="tablewrap">
    <table>
        <thead>
        <tr>
            <th style="min-width:180px">@Text.LineColumn1Header <span class="req">*</span></th>
            <th style="min-width:150px">@Text.LineColumn2Header</th>
            <th style="min-width:170px">@Text.LineColumn3Header</th>
            <th style="min-width:120px">Receipt / tax invoice</th>
            <th class="num" style="width:120px">Gross incl. GST <span class="req">*</span></th>
            <th class="num" style="width:110px">GST shown</th>
            <th class="num" style="width:110px">Church use %</th>
            <th style="width:38px"><span class="sr-only">Remove</span></th>
        </tr>
        </thead>
        <tbody>
        @foreach (ExpenseLineModel line in Model.Lines)
        {
            @* @key on the model's own stable Guid: without it Blazor reuses a removed row's DOM for the
               row that shifted up, and the cursor and any uncommitted keystroke land in the wrong line. *@
            <tr @key="line.Key">
                <td>
                    @if (Model.Kind == SubmissionKind.DebitCardPurchase)
                    {
                        <input type="text" aria-label="@Text.LineColumn1Header"
                               @bind="line.ItemDescription" @bind:event="oninput"/>
                    }
                    else
                    {
                        <input type="date" aria-label="@Text.LineColumn1Header"
                               @bind="line.LineDate" @bind:event="oninput"/>
                    }
                </td>
                <td><input type="text" aria-label="@Text.LineColumn2Header"
                           @bind="line.Details" @bind:event="oninput"/></td>
                <td><input type="text" aria-label="@Text.LineColumn3Header"
                           @bind="line.Purpose" @bind:event="oninput"/></td>
                <td>
                    <select aria-label="Receipt or tax invoice" @bind="line.Evidence" @bind:after="Changed">
                        <option value="@EvidenceStatus.Attached">Attached</option>
                        <option value="@EvidenceStatus.Missing">Missing</option>
                    </select>
                </td>
                <td class="num">
                    <div class="money">
                        <input type="number" step="0.01" min="0" aria-label="Gross including GST"
                               @bind="line.GrossAmount" @bind:event="oninput" @bind:after="Changed"/>
                    </div>
                </td>
                <td class="num">
                    <div class="money">
                        <input type="number" step="0.01" min="0" aria-label="GST shown"
                               @bind="line.GstAmount" @bind:event="oninput" @bind:after="Changed"/>
                    </div>
                </td>
                <td class="num">
                    <input type="number" step="0.01" min="0" max="100" class="mono" aria-label="Church use percent"
                           @bind="line.ChurchUsePercent" @bind:event="oninput"/>
                </td>
                <td>
                    @* Hidden rather than disabled on the last row: a control that is present but dead
                       invites clicking. Removing the only line would leave a table with no rows and no
                       visible way back. *@
                    @if (Model.Lines.Count > 1)
                    {
                        <button class="rowbtn" type="button" title="Remove this line"
                                aria-label="Remove line" @onclick="() => Remove(line)">&times;</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@* Neither paper table's printed row count is a limit - four rows on one form and five on the other is
   what fits on the page. Nothing here caps the count. *@
<button class="btn-add" type="button" @onclick="Add">+ Add line</button>

<div class="totals">
    <span class="k">@Text.GrossTotalLabel</span>
    <span class="v mono">@Model.GrossTotal.ToString("C2")</span>

    <span class="k">GST shown on evidence</span>
    <span class="v mono">@Model.GstTotal.ToString("C2")</span>

    <span class="k">@Text.LessPersonalLabel</span>
    <span class="v">
        <div class="money">
            <input type="number" step="0.01" min="0" aria-label="@Text.LessPersonalLabel"
                   @bind="Model.LessPersonalAmount" @bind:event="oninput" @bind:after="Changed"/>
        </div>
    </span>

    <span class="rule"></span>

    <span class="k net">@Text.NetTotalLabel</span>
    <span class="v net mono">@Model.NetTotal.ToString("C2")</span>
</div>

@*
    These figures are the browser's. The server recomputes all of them from the lines and writes its own;
    if they ever disagree the server is right and this is the bug. They exist because a total that only
    updates after a round trip makes a form feel broken.
*@

@if (Model.ChargeMismatch)
{
    <div class="notice warn" style="margin-top:14px">
        <span class="ico">&ne;</span>
        <div>
            <b>Lines don't match the card charge.</b> Itemised lines total
            <span class="mono">@Model.GrossTotal.ToString("C2")</span> but the amount charged in section 1
            is <span class="mono">@(Model.AmountCharged?.ToString("C2"))</span>. Add the missing lines or
            correct the charge before submitting.
        </div>
    </div>
}

@code
{
    [Parameter, EditorRequired] public required ExpenseFormModel Model { get; set; }

    [Parameter, EditorRequired] public required ExpenseFormText Text { get; set; }

    /// <summary>Lets the page react - the action bar's running totals, the section 5 reveal.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task Changed() => await OnChanged.InvokeAsync();

    private async Task Add()
    {
        Model.AddLine();
        await Changed();
    }

    private async Task Remove(ExpenseLineModel line)
    {
        Model.RemoveLine(line);
        await Changed();
    }
}
