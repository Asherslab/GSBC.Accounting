<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!--
            OverrideHtmlAssetPlaceholders is deliberately NOT set, and setting it breaks the published
            site. It arrived with the slice 0 scaffold for no recorded reason and took the deployment
            down on 2026-08-31.

            With it on, `dotnet publish` content-hashes the Blazor loader itself
            (blazor.webassembly.66stpp682q.js) but does NOT rewrite index.html's reference to match -
            neither the plain name nor a `#[.{fingerprint}]` marker is substituted; both were tried.
            The result is a 404 on the loader, refused by nosniff because nginx's SPA fallback answers
            it as text/html, and a blank page.

            It fails ONLY when published. The dev server serves unfingerprinted assets, so nothing is
            wrong locally. GSBC.ImpactKids does not set this either, which is why its plain reference
            has always worked in the cluster.
        -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire4Wasm.WebAssembly" Version="6.0.1" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.1" />

        <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
        <PackageReference Include="Grpc.Net.Client.Web" Version="2.71.0" />
        <PackageReference Include="Grpc.Net.ClientFactory" Version="2.71.0" />
        <PackageReference Include="protobuf-net.Grpc.ClientFactory" Version="1.2.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GSBC.Accounting.Shared.Contracts\GSBC.Accounting.Shared.Contracts.csproj" />
    </ItemGroup>

</Project>
